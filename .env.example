# =============================================================================
# Zalo Sales CRM - Biến môi trường
# =============================================================================
# Sao chép file này thành .env và điền thông tin phù hợp:
#   cp .env.example .env

# --- Server ---
PORT=3000
NODE_ENV=production
# URL công khai, dùng cho links/redirect VÀ là danh sách origin được phép gọi
# API/socket khi NODE_ENV=production.
# Nhiều đường vào thì cách nhau dấu phẩy, giá trị đầu tiên dùng cho link/redirect:
#   APP_URL=https://crm.tendomain.com,http://192.168.1.6:3080
APP_URL=https://zalocrm.shinsulab.com

# --- Bảo mật (BẮT BUỘC — tạo giá trị ngẫu nhiên cho production) ---
# JWT_SECRET: chuỗi ngẫu nhiên, tối thiểu 32 ký tự
#   Tạo: openssl rand -hex 32
JWT_SECRET=

# ENCRYPTION_KEY: đúng 32 bytes (64 hex chars) cho AES-256-GCM
#   Tạo: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Database (PostgreSQL 16+) ---
DB_USER=crmuser
# Bắt buộc: mật khẩu Postgres
DB_PASSWORD=
DB_NAME=zalocrm
DATABASE_URL=postgresql://crmuser:password@db:5432/zalocrm
# Lưu ý: thay "password" trong DATABASE_URL khớp với DB_PASSWORD ở trên

# --- Local Storage (file gốc lưu trên server) ---
UPLOAD_DIR=/var/lib/zalo-crm/files

# --- Redis (event-buffer + cache) ---
# Bỏ comment dòng dưới để bật Redis mode; bỏ trống để dùng in-memory
# Start Redis container: docker compose up -d redis
REDIS_URL=redis://redis:6379

# --- Object Storage (S3-compatible: MinIO hoac Cloudflare R2) ---
# Doi ha tang luu tru = doi DUY NHAT bien STORAGE_PROVIDER. Khong sua code.
# Bang khac biet giua cac provider nam o backend/src/shared/storage/s3-storage.ts
# (STORAGE_PROFILES). Them provider moi = them mot dong vao bang do.
#
#   minio : URL cong khai {origin}/{bucket}/{key}  (path-style)
#           app tu tao bucket + set policy public-read khi khoi dong
#   r2    : URL cong khai {origin}/{key}           (custom domain tro goc bucket)
#           bucket tao san ngoai app, app chi kiem tra ton tai
#
# De trong = r2 (giu nguyen hanh vi cua ban truoc khi co adapter, nen deploy cu
# chua khai bien nay se khong bi doi gi).
STORAGE_PROVIDER=minio

# Endpoint S3 API ma backend goi (trong docker network).
S3_ENDPOINT=http://minio:9000

# Origin cong khai cho browser/Zalo CDN.
# QUAN TRONG: chi la ORIGIN, KHONG them ten bucket vao day — adapter tu ghep
# theo provider. Them bucket vao day la lap hai lan -> moi anh 404.
# Production: thay localhost bang domain/IP browser truy cap duoc.
S3_PUBLIC_URL=http://localhost:9000

S3_BUCKET=zalocrm-attachments
# De trong = profile tu quyet (minio: us-east-1, r2: auto).
S3_REGION=
# Voi MinIO local: khop voi MINIO_ROOT_USER/MINIO_ROOT_PASSWORD ben duoi
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Cache-Control max-age (giay) cho object upload. 259200 = 3 ngay, khop lifecycle
# rule cua bucket R2 (object bi xoa sau 3 ngay nen khong duoc cache lau hon).
S3_CACHE_MAX_AGE=259200

# Host/prefix cua kho CU con sot trong DB, phan cach bang dau phay.
# Dung de isOwnStorageUrl() nhan ra URL cu va KHONG mirror lai thanh vong lap
# tu sao chep. URL MinIO 127.0.0.1:9000 da duoc nhan san, khong can khai lai.
#   Vi du khi doi tu MinIO sang R2: S3_LEGACY_URL_PREFIXES=files.zalocrm.shinsulab.com/
S3_LEGACY_URL_PREFIXES=

# Chuyen sang Cloudflare R2: dat STORAGE_PROVIDER=r2 roi dien 4 dong duoi.
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=https://<custom-domain-tro-vao-goc-bucket>
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret-access-key>

# MinIO root credentials (dùng bởi service minio trong docker-compose)
# Production: ĐỔI MẬT KHẨU mạnh — đây là tài khoản admin của MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Commercial License Key (tùy chọn — ẩn banner attribution) ---
# ZaloCRM phân phối theo Apache License 2.0, banner attribution chạy trên top-nav
# là điều bắt buộc theo §4(d). Để ẩn banner này hợp pháp, bạn cần mua commercial
# license và điền key được cấp vào FRIENDS bên dưới.
# Liên hệ mua license: dmman16pn@gmail.com
# FRIENDS=

# --- AI — Global defaults ---
# anthropic | gemini | openai | qwen | kimi
AI_DEFAULT_PROVIDER=anthropic
AI_DEFAULT_MODEL=claude-sonnet-4.6

# --- AI Provider: Anthropic ---
ANTHROPIC_BASE_URL=https://api.anthropic.com
# API key từ console.anthropic.com
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_DEFAULT_OPUS_MODEL=claude-opus-4.6
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-sonnet-4.6
ANTHROPIC_DEFAULT_HAIKU_MODEL=claude-haiku-4.5

# --- AI Provider: Claude Code CLI (dùng GÓI CƯỚC Pro/Max, KHÔNG dùng API key) ---
# Trừ vào hạn mức gói tháng thay vì tính tiền theo token.
# ĐIỀU KIỆN: máy chủ phải cài Claude Code CLI và đã `claude /login` bằng tài khoản subscription.
# ⚠️ Gói tiêu dùng cá nhân + giới hạn cửa sổ 5h/tuần — dùng cho backend đa người dùng là
#    vùng xám điều khoản và dễ chạm trần. Khuyến nghị chỉ dùng cho cá nhân/test.
# Bật: đặt CLAUDE_CLI_ENABLED=1 rồi chọn provider 'claude-cli' trong Settings AI của org.
CLAUDE_CLI_ENABLED=
CLAUDE_CLI_BIN=claude
CLAUDE_CLI_MODEL=claude-sonnet-4-6

# --- AI Provider: Gemini ---
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# API key từ ai.google.dev
GEMINI_AUTH_TOKEN=
GEMINI_DEFAULT_PRO_MODEL=gemini-1.5-pro
GEMINI_DEFAULT_FLASH_MODEL=gemini-2.5-flash

# --- AI Provider: OpenAI ---
OPENAI_BASE_URL=https://api.openai.com
# API key từ platform.openai.com
OPENAI_AUTH_TOKEN=
OPENAI_DEFAULT_GPT4O_MODEL=gpt-4o
OPENAI_DEFAULT_GPT4O_MINI_MODEL=gpt-4o-mini

# --- AI Provider: Qwen (Alibaba DashScope) ---
QWEN_BASE_URL=https://dashscope.aliyuncs.com
QWEN_AUTH_TOKEN=
QWEN_DEFAULT_PLUS_MODEL=qwen-plus
QWEN_DEFAULT_TURBO_MODEL=qwen-turbo
QWEN_DEFAULT_MAX_MODEL=qwen-max

# --- AI Provider: Kimi (Moonshot) ---
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_AUTH_TOKEN=
KIMI_DEFAULT_MOONSHOT_V1_MODEL=moonshot-v1-8k

# --- Facebook Integration ---
# Graph API version
FB_GRAPH_API_VERSION=v21.0

# App credentials — lấy từ https://developers.facebook.com → Your App → Settings → Basic
FB_APP_ID=
FB_APP_SECRET=

# FB Lead Ingestion — các biến bổ sung (tự sinh hoặc cấu hình)
# FB_WEBHOOK_VERIFY_TOKEN: chuỗi bí mật tự đặt, dùng để xác thực webhook từ Facebook
#   Tạo: openssl rand -hex 16
FB_WEBHOOK_VERIFY_TOKEN=

# FB_TOKEN_ENC_KEY: key mã hóa page access token lưu trong DB (32 bytes = 64 hex chars)
#   Tạo: openssl rand -hex 32
FB_TOKEN_ENC_KEY=

# FB_OAUTH_REDIRECT_URI: URL callback sau khi user cấp quyền Facebook OAuth
#   Phải khớp với "Valid OAuth Redirect URIs" trong Facebook App Dashboard
FB_OAUTH_REDIRECT_URI=https://yourdomain.com/api/v1/integrations/facebook/oauth/callback

# ── Giới hạn gửi tin nhắn Zalo (rate limiter) ──────────────────────────────
# ZALO_MSG_DAILY_LIMIT: trần số tin/ngày/nick. 0 = KHÔNG giới hạn (mặc định).
#   Lưu ý: đây chỉ là chặn phía CRM — Zalo vẫn có chính sách chống spam riêng,
#   gửi quá nhiều/nhanh có thể bị khóa nick. Tự cân nhắc giãn nhịp.
ZALO_MSG_DAILY_LIMIT=0
# ZALO_MSG_BURST: chặn gửi dồn >N tin/30s (lưới chống vòng lặp gửi vô hạn).
#   5 = mặc định. Đặt 0 để tắt hoàn toàn.
ZALO_MSG_BURST=5
# BROADCAST_GROUP_DELAY_MS: giãn nhịp (ms) giữa các nhóm khi đăng bài loạt (broadcast).
#   Mặc định code = 7000. Tăng để né Zalo throttle (giảm fetch failed ở nhóm sau).
BROADCAST_GROUP_DELAY_MS=15000

# --- Tài khoản admin bootstrap (đăng nhập bằng SĐT hoặc email) ---
# Khi có đủ PHONE + PASSWORD, server tự tạo/đảm bảo tài khoản này lúc khởi động
# (idempotent). Dùng để không ai vào được app nếu chưa có tài khoản.
BOOTSTRAP_ADMIN_PHONE=0900000000
BOOTSTRAP_ADMIN_PASSWORD=DoiMatKhauNgay@@
BOOTSTRAP_ADMIN_NAME=Quản trị viên
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ORG_NAME=Shin Su Lab
# =true để RESET mật khẩu admin về giá trị trên mỗi lần khởi động (mặc định false).
BOOTSTRAP_ADMIN_RESET_PASSWORD=false
